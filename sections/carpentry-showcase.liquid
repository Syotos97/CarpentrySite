{% liquid
  assign use_tabs = section.settings.enable_tabs
  assign showcase_anchor_id = section.settings.anchor_id
  if section.blocks.size < 2
    assign use_tabs = false
  endif

  if showcase_anchor_id == blank and request.page_type == 'index' and section.id == 'home_custom_orders'
    assign showcase_anchor_id = 'made-for-your-space'
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id, skip_contrast: true
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>
<section
  {% if showcase_anchor_id != blank %}
    id="{{ showcase_anchor_id | escape }}"
  {% endif %}
  class="section section--{{ section.settings.section_width }} carpentry-showcase spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}"
>
  <div class="carpentry-showcase__shell">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank %}
      <div class="carpentry-showcase__header">
        {% if section.settings.eyebrow != blank %}
          <p class="carpentry-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="carpentry-showcase__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.intro != blank %}
          <div class="carpentry-showcase__intro rte">{{ section.settings.intro }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if use_tabs %}
      <div class="carpentry-showcase__tablist" role="tablist" aria-label="{{ section.settings.heading | escape }}" data-showcase-tabs>
        {% for block in section.blocks %}
          {% assign tab_label = block.settings.tab_label | default: block.settings.title %}
          <button
            type="button"
            class="carpentry-showcase__tab"
            id="ShowcaseTab-{{ section.id }}-{{ block.id }}"
            role="tab"
            aria-controls="ShowcasePanel-{{ section.id }}-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-tab-trigger
            {{ block.shopify_attributes }}
          >
            <span class="carpentry-showcase__tab-label">{{ tab_label }}</span>
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="carpentry-showcase__panels{% unless use_tabs %} carpentry-showcase__panels--stacked{% endunless %}">
      {% for block in section.blocks %}
        {% assign has_images = false %}
        {% assign asset_gallery_key = block.settings.asset_gallery_key %}
        {% assign asset_gallery_layout = block.settings.asset_gallery_layout %}
        {% assign asset_gallery_files = '' %}
        {% case asset_gallery_key %}
          {% when 'home-projects-all' %}
            {% assign asset_gallery_files = 'IMG_0317.jpg|IMG_0336.jpg|IMG_1158.jpg|IMG_1252.jpg|IMG_1290.jpg|IMG_1388.jpg|IMG_1533.jpg|IMG_7437.jpg' %}
          {% when 'home-orders' %}
            {% assign asset_gallery_files = 'IMG_1387.jpg|IMG_1432.jpg|IMG_1754.jpg' %}
          {% when 'home-shipping' %}
            {% assign asset_gallery_files = 'IMG_0319.jpg|IMG_0320.jpg|IMG_0338.jpg' %}
          {% when 'home-reviews' %}
            {% assign asset_gallery_files = 'IMG_1207.jpg|IMG_1290.jpg|IMG_1753.jpg|IMG_0675.jpg' %}
          {% when 'custom-orders-start' %}
            {% assign asset_gallery_files = 'IMG_0319.jpg|IMG_1290.jpg|IMG_1213.jpg' %}
          {% when 'custom-orders-design' %}
            {% assign asset_gallery_files = 'IMG_1387.jpg|IMG_1252.jpg|IMG_1433.jpg' %}
          {% when 'custom-orders-quote' %}
            {% assign asset_gallery_files = 'IMG_0317.jpg|IMG_0336.jpg|IMG_1533.jpg' %}
          {% when 'quote-scope' %}
            {% assign asset_gallery_files = 'IMG_0317.jpg|IMG_0336.jpg|IMG_1158.jpg' %}
          {% when 'quote-site' %}
            {% assign asset_gallery_files = 'IMG_0319.jpg|IMG_1290.jpg|IMG_1252.jpg' %}
          {% when 'quote-response' %}
            {% assign asset_gallery_files = 'IMG_1387.jpg|IMG_1433.jpg|IMG_1754.jpg' %}
          {% when 'shipping-local' %}
            {% assign asset_gallery_files = 'IMG_0317.jpg|IMG_1158.jpg|IMG_1290.jpg' %}
          {% when 'shipping-freight' %}
            {% assign asset_gallery_files = 'IMG_0335.jpg|IMG_0336.jpg|IMG_0337.jpg' %}
          {% when 'shipping-timeline' %}
            {% assign asset_gallery_files = 'IMG_1213.jpg|IMG_1252.jpg|IMG_1387.jpg' %}
          {% when 'reviews-quality' %}
            {% assign asset_gallery_files = 'IMG_1387.jpg|IMG_1388.jpg|IMG_1754.jpg' %}
          {% when 'reviews-service' %}
            {% assign asset_gallery_files = 'IMG_0317.jpg|IMG_1252.jpg|IMG_1433.jpg' %}
          {% when 'reviews-outcomes' %}
            {% assign asset_gallery_files = 'IMG_0336.jpg|IMG_1290.jpg|IMG_1533.jpg' %}
        {% endcase %}
        {% assign asset_gallery_items = asset_gallery_files | split: '|' %}
        {% assign asset_gallery_has_items = false %}
        {% for asset_gallery_item in asset_gallery_items %}
          {% if asset_gallery_item != blank %}
            {% assign asset_gallery_has_items = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        {% assign asset_gallery_alt = block.settings.asset_gallery_alt | default: block.settings.title | default: section.settings.heading %}
        {% if block.settings.image_1 != blank or block.settings.image_2 != blank or block.settings.image_3 != blank or asset_gallery_has_items %}
          {% assign has_images = true %}
        {% endif %}
        {% assign feature_items = block.settings.feature_list | newline_to_br | split: '<br />' %}
        <article
          class="carpentry-showcase__panel"
          id="ShowcasePanel-{{ section.id }}-{{ block.id }}"
          {% if use_tabs %}
            role="tabpanel"
            aria-labelledby="ShowcaseTab-{{ section.id }}-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
          {% endif %}
          data-tab-panel
          {{ block.shopify_attributes }}
        >
          <div class="carpentry-showcase__panel-copy">
            {% if block.settings.kicker != blank %}
              <p class="carpentry-showcase__kicker">{{ block.settings.kicker }}</p>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="carpentry-showcase__panel-heading">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="carpentry-showcase__panel-text rte">{{ block.settings.text }}</div>
            {% endif %}

            {% assign has_features = false %}
            {% for item in feature_items %}
              {% assign stripped_item = item | strip %}
              {% if stripped_item != blank %}
                {% assign has_features = true %}
                {% break %}
              {% endif %}
            {% endfor %}

            {% if has_features %}
              <ul class="carpentry-showcase__feature-list" role="list">
                {% for item in feature_items %}
                  {% assign stripped_item = item | strip %}
                  {% if stripped_item != blank %}
                    <li>{{ stripped_item }}</li>
                  {% endif %}
                {% endfor %}
              </ul>
            {% endif %}

            {% if block.settings.button_label != blank and block.settings.button_link != blank %}
              <a class="button button-secondary carpentry-showcase__button" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label }}
              </a>
            {% endif %}
          </div>

          {% if has_images or block.settings.callout_title != blank or block.settings.callout_text != blank %}
            <div class="carpentry-showcase__panel-media">
              {% if block.settings.callout_title != blank or block.settings.callout_text != blank %}
                <div class="carpentry-showcase__callout">
                  {% if block.settings.callout_title != blank %}
                    <h4>{{ block.settings.callout_title }}</h4>
                  {% endif %}
                  {% if block.settings.callout_text != blank %}
                    <p>{{ block.settings.callout_text | newline_to_br }}</p>
                  {% endif %}
                </div>
              {% endif %}

              {% if has_images %}
                {% if asset_gallery_has_items %}
                  {% if asset_gallery_layout == 'slideshow' %}
                    <div class="carpentry-showcase__asset-slideshow" data-asset-slideshow>
                      <div class="carpentry-showcase__asset-slideshow-track" data-asset-slideshow-track>
                        {% for asset_gallery_item in asset_gallery_items %}
                          {% if asset_gallery_item != blank %}
                            <div class="carpentry-showcase__asset-slideshow-slide">
                              <img
                                src="{{ asset_gallery_item | asset_url }}"
                                alt="{{ asset_gallery_alt | escape }} photo {{ forloop.index }}"
                                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                              >
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>
                      <div class="carpentry-showcase__asset-slideshow-footer">
                        <div class="carpentry-showcase__asset-slideshow-nav">
                          <button type="button" class="carpentry-showcase__asset-button" data-asset-slideshow-prev aria-label="Previous project photo">
                            Previous
                          </button>
                          <button type="button" class="carpentry-showcase__asset-button" data-asset-slideshow-next aria-label="Next project photo">
                            Next
                          </button>
                        </div>
                        <p class="carpentry-showcase__asset-slideshow-status" data-asset-slideshow-status>
                          1 / {{ asset_gallery_items.size }}
                        </p>
                      </div>
                    </div>
                  {% else %}
                    <div class="carpentry-showcase__gallery{% if asset_gallery_items.size < 3 %} carpentry-showcase__gallery--compact{% endif %}">
                      {% for asset_gallery_item in asset_gallery_items %}
                        {% if asset_gallery_item != blank %}
                          <div class="carpentry-showcase__gallery-item carpentry-showcase__gallery-item--{{ forloop.index }}">
                            <img
                              src="{{ asset_gallery_item | asset_url }}"
                              alt="{{ asset_gallery_alt | escape }} photo {{ forloop.index }}"
                              loading="lazy"
                            >
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                {% else %}
                  <div class="carpentry-showcase__gallery{% if block.settings.image_3 == blank %} carpentry-showcase__gallery--compact{% endif %}">
                    {% for image_index in (1..3) %}
                      {% liquid
                        assign image_key = 'image_' | append: image_index
                        assign image = block.settings[image_key]
                      %}
                      {% if image != blank %}
                        <div class="carpentry-showcase__gallery-item carpentry-showcase__gallery-item--{{ image_index }}">
                          {{
                            image
                            | image_url: width: 1400
                            | image_tag:
                              widths: '480, 720, 960, 1400',
                              sizes: '(min-width: 750px) 30vw, 100vw',
                              loading: 'lazy',
                              alt: image.alt
                          }}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .carpentry-showcase[id] {
    scroll-margin-top: calc(var(--header-group-height, 0px) + 24px);
  }

  .carpentry-showcase {
    --carpentry-surface: color-mix(in srgb, var(--color-background) 90%, #b78249 10%);
    --carpentry-border: color-mix(in srgb, var(--color-foreground) 14%, transparent);
    --carpentry-accent: #8f5b31;
    --carpentry-accent-soft: #ead8c0;
  }

  .carpentry-showcase__shell {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-background) 94%, #f4e6d4 6%), var(--color-background)),
      radial-gradient(circle at top left, rgba(183, 130, 73, 0.18), transparent 32%);
    border: 1px solid var(--carpentry-border);
    border-radius: 2rem;
    padding: clamp(1.25rem, 2vw, 2rem);
    box-shadow: 0 1.25rem 3rem rgba(32, 19, 9, 0.08);
  }

  .carpentry-showcase__header {
    max-width: 48rem;
    margin-block-end: 1.75rem;
  }

  .carpentry-showcase__eyebrow,
  .carpentry-showcase__kicker {
    margin: 0 0 0.6rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--carpentry-accent);
  }

  .carpentry-showcase__heading,
  .carpentry-showcase__panel-heading {
    margin: 0;
    text-wrap: balance;
  }

  .carpentry-showcase__intro {
    margin-top: 0.9rem;
    color: color-mix(in srgb, var(--color-foreground) 76%, transparent);
  }

  .carpentry-showcase__tablist {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-block-end: 1.5rem;
  }

  .carpentry-showcase__tab {
    appearance: none;
    border: 1px solid var(--carpentry-border);
    background: rgba(255, 255, 255, 0.5);
    color: inherit;
    border-radius: 999px;
    padding: 0.85rem 1.15rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .carpentry-showcase__tab:hover,
  .carpentry-showcase__tab:focus-visible,
  .carpentry-showcase__tab[aria-selected='true'] {
    background: var(--carpentry-accent);
    border-color: var(--carpentry-accent);
    color: #fff;
    transform: translateY(-1px);
  }

  .carpentry-showcase__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
    padding: clamp(1rem, 1.5vw, 1.25rem);
    background: color-mix(in srgb, var(--color-background) 95%, #fff 5%);
    border-radius: 1.5rem;
    border: 1px solid rgba(143, 91, 49, 0.12);
  }

  .carpentry-showcase__panels--stacked {
    display: grid;
    gap: 1rem;
  }

  .carpentry-showcase__panel-text {
    margin-top: 0.9rem;
  }

  .carpentry-showcase__feature-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: grid;
    gap: 0.75rem;
  }

  .carpentry-showcase__feature-list li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .carpentry-showcase__feature-list li::before {
    content: '';
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.35rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--carpentry-accent), #c89661);
    box-shadow: 0 0 0 0.3rem rgba(143, 91, 49, 0.12);
  }

  .carpentry-showcase__button {
    margin-top: 1.5rem;
  }

  .carpentry-showcase__panel-media {
    display: grid;
    gap: 1rem;
  }

  .carpentry-showcase__callout {
    background: linear-gradient(145deg, var(--carpentry-accent-soft), rgba(255, 255, 255, 0.95));
    color: #35210f;
    border-radius: 1.25rem;
    padding: 1.1rem 1.15rem;
    border: 1px solid rgba(143, 91, 49, 0.16);
  }

  .carpentry-showcase__callout h4 {
    margin: 0 0 0.5rem;
  }

  .carpentry-showcase__callout p {
    margin: 0;
  }

  .carpentry-showcase__gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .carpentry-showcase__gallery--compact {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .carpentry-showcase__gallery-item--1 {
    grid-column: 1 / -1;
  }

  .carpentry-showcase__gallery-item img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 12rem;
    object-fit: cover;
    border-radius: 1rem;
  }

  .carpentry-showcase__asset-slideshow {
    display: grid;
    gap: 0.9rem;
  }

  .carpentry-showcase__asset-slideshow-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: 1rem;
    overscroll-behavior-x: contain;
  }

  .carpentry-showcase__asset-slideshow-track::-webkit-scrollbar {
    display: none;
  }

  .carpentry-showcase__asset-slideshow-slide {
    scroll-snap-align: start;
  }

  .carpentry-showcase__asset-slideshow-slide img {
    display: block;
    width: 100%;
    min-height: clamp(18rem, 42vw, 28rem);
    object-fit: cover;
    border-radius: 1rem;
  }

  .carpentry-showcase__asset-slideshow-footer,
  .carpentry-showcase__asset-slideshow-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .carpentry-showcase__asset-button {
    appearance: none;
    border: 1px solid var(--carpentry-border);
    background: rgba(255, 255, 255, 0.78);
    color: inherit;
    border-radius: 999px;
    padding: 0.65rem 1rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .carpentry-showcase__asset-button:hover,
  .carpentry-showcase__asset-button:focus-visible {
    background: var(--carpentry-accent);
    border-color: var(--carpentry-accent);
    color: #fff;
  }

  .carpentry-showcase__asset-slideshow-status {
    margin: 0;
    color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
    font-size: 0.95rem;
  }

  @media screen and (max-width: 749px) {
    .carpentry-showcase__shell {
      border-radius: 1.5rem;
      padding: 1rem;
    }

    .carpentry-showcase__panel {
      grid-template-columns: 1fr;
      padding: 1rem;
    }

    .carpentry-showcase__tab {
      width: 100%;
      justify-content: flex-start;
    }

    .carpentry-showcase__gallery,
    .carpentry-showcase__gallery--compact {
      grid-template-columns: 1fr;
    }

    .carpentry-showcase__asset-slideshow-slide img {
      min-height: 16rem;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    const currentScript = document.currentScript;
    const section = document.getElementById('shopify-section-{{ section.id }}') || currentScript.closest('.shopify-section');

    if (!section) {
      return;
    }

    if (section.dataset.carpentryShowcaseTabsBound !== 'true') {
      const tabs = Array.from(section.querySelectorAll('[data-tab-trigger]'));
      const panels = Array.from(section.querySelectorAll('[data-tab-panel]'));

      if (tabs.length && panels.length) {
        section.dataset.carpentryShowcaseTabsBound = 'true';

        const activateTab = (index) => {
          tabs.forEach((tab, tabIndex) => {
            const isActive = tabIndex === index;
            tab.setAttribute('aria-selected', String(isActive));
            tab.setAttribute('tabindex', isActive ? '0' : '-1');
          });

          panels.forEach((panel, panelIndex) => {
            panel.hidden = panelIndex !== index;
          });
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activateTab(index));
          tab.addEventListener('keydown', (event) => {
            let nextIndex = index;

            if (event.key === 'ArrowRight') {
              nextIndex = (index + 1) % tabs.length;
            } else if (event.key === 'ArrowLeft') {
              nextIndex = (index - 1 + tabs.length) % tabs.length;
            } else if (event.key === 'Home') {
              nextIndex = 0;
            } else if (event.key === 'End') {
              nextIndex = tabs.length - 1;
            } else {
              return;
            }

            event.preventDefault();
            activateTab(nextIndex);
            tabs[nextIndex].focus();
          });
        });
      }
    }

    if (section.dataset.carpentryShowcaseSlideshowsBound === 'true') {
      return;
    }

    const slideshows = Array.from(section.querySelectorAll('[data-asset-slideshow]'));

    if (!slideshows.length) {
      return;
    }

    section.dataset.carpentryShowcaseSlideshowsBound = 'true';

    slideshows.forEach((slideshow) => {
      const track = slideshow.querySelector('[data-asset-slideshow-track]');
      const previousButton = slideshow.querySelector('[data-asset-slideshow-prev]');
      const nextButton = slideshow.querySelector('[data-asset-slideshow-next]');
      const status = slideshow.querySelector('[data-asset-slideshow-status]');
      const slides = Array.from(slideshow.querySelectorAll('.carpentry-showcase__asset-slideshow-slide'));

      if (!track || !previousButton || !nextButton || !status || slides.length < 2) {
        return;
      }

      const getSlideWidth = () => slides[0].getBoundingClientRect().width || track.clientWidth;
      const getIndex = () => {
        const slideWidth = getSlideWidth();

        if (!slideWidth) {
          return 0;
        }

        return Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / slideWidth)));
      };

      const updateStatus = () => {
        status.textContent = `${getIndex() + 1} / ${slides.length}`;
      };

      const scrollToIndex = (index) => {
        const slideWidth = getSlideWidth();

        if (!slideWidth) {
          return;
        }

        track.scrollTo({
          left: slideWidth * index,
          behavior: 'smooth'
        });
      };

      previousButton.addEventListener('click', () => {
        const nextIndex = (getIndex() - 1 + slides.length) % slides.length;
        scrollToIndex(nextIndex);
      });

      nextButton.addEventListener('click', () => {
        const nextIndex = (getIndex() + 1) % slides.length;
        scrollToIndex(nextIndex);
      });

      track.addEventListener('scroll', () => {
        window.requestAnimationFrame(updateStatus);
      });

      window.addEventListener('resize', updateStatus);
      updateStatus();
    });
  })();
</script>

{% schema %}
{
  "name": "Carpentry showcase",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Built to order"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Showcase projects, explain the process, and guide buyers to the right next step"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Use this section to highlight your best builds, custom order workflow, shipping expectations, and client feedback in one place.</p>"
    },
    {
      "type": "checkbox",
      "id": "enable_tabs",
      "label": "Enable tab navigation",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "full-width",
          "label": "Full width"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#e8ddd0"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
